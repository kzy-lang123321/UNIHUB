{
  "expo": {
    "name": "UniHub",
    "slug": "unihub",
    "scheme": "unihub",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-document-picker",
      "./plugins/withLocalLibrary.cjs"
    ],
    "icon": "./assets/icon.png",
    "android": { "package": "com.megatech.unihub", "versionCode": 3 },
    "ios": {
      "bundleIdentifier": "com.megatech.unihub",
      "buildNumber": "3",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow UniHub to use Face ID for secure student biometric access."
      }
    },
    "experiments": { "typedRoutes": true }
  }
}
