{
  "name": "unihub",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "library:serve": "tsx scripts/library-server.ts",
    "library:import": "python scripts/library-ingest.py --source \"E:/projects/in work/akl project/DEPARTMENTS NOTES\" --state E:/UniHubLibrary --render-office",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app src scripts tests e2e *.json *.ts README.md",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "^2.0.2",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.0",
    "expo-linking": "~8.0.0",
    "expo-local-authentication": "~17.0.0",
    "expo-router": "~6.0.0",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.0",
    "firebase": "^12.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mmkv": "^3.3.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
